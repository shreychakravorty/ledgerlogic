{
  "name": "LearningAttempt",
  "type": "object",
  "properties": {
    "activity_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "lesson",
        "support",
        "course_lesson",
        "course_quiz",
        "course_exam"
      ]
    },
    "topic": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "mistakes": {
      "type": "number"
    },
    "completed_on": {
      "type": "string"
    },
    "attempt_key": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "activity_id",
    "kind",
    "topic",
    "score",
    "completed_on"
  ]
}